// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup
    
    // spawn-at-startup "qs" "-c" "noctalia-shell" "--no-duplicate"
    spawn-at-startup "noctalia-shell"
    spawn-at-startup "swayidle" "-w" "before-sleep" "qs -c noctalia-shell ipc call lockScreen lock"
