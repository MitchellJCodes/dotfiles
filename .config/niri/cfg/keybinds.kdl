binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

    // ─── noctalia-shell keybinds ───
    // https://docs.noctalia.dev/getting-started/keybinds/

    Mod+Shift+Slash                     { show-hotkey-overlay; }



    // ─── Applications ───
    Mod+Return                          hotkey-overlay-title="Open Terminal: Ghostty" { spawn "ghostty"; }
    Mod+B                               hotkey-overlay-title="Open Browser: Librewolf" { spawn "librewolf"; }
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Mod+CTRL+B { spawn-sh "noctalia msg bar-toggle"; }
    Mod+V { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Shift+W { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Shift+E { spawn-sh "noctalia msg panel-toggle launcher /emo"; }
    Mod+CTRL+W { spawn-sh "noctalia msg wallpaper-random"; }
    Mod+CTRL+Q { spawn-sh "noctalia msg panel-toggle session"; }



    // Please choose your own file manager.
    Mod+E                               hotkey-overlay-title="File Manager: Nautilus" { spawn "nautilus"; }

    // ─── Media Controls ───
    XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }



    // ─── Window Movement and Focus ───
    Mod+Q                               { close-window; }


    Mod+Left                            { focus-column-or-monitor-left; }
    Mod+H                               { focus-column-or-monitor-left; }
    Mod+Right                           { focus-column-or-monitor-right; }
    Mod+L                               { focus-column-or-monitor-right; }
    Mod+Up                              { focus-window-or-workspace-up; }
    Mod+K                               { focus-window-or-workspace-up; }
    Mod+Down                            { focus-window-or-workspace-down; }
    Mod+J                               { focus-window-or-workspace-down; }


    Mod+shift+Left                       { move-column-left-or-to-monitor-left; }
    Mod+shift+H                          { move-column-left-or-to-monitor-left; }
    Mod+shift+Right                      { move-column-right-or-to-monitor-right; }
    Mod+shift+L                          { move-column-right-or-to-monitor-right; }
    Mod+shift+UP                         { move-window-up-or-to-workspace-up; }
    Mod+shift+K                          { move-window-up-or-to-workspace-up; }
    Mod+shift+Down                       { move-window-down-or-to-workspace-down; }
    Mod+shift+J                          { move-window-down-or-to-workspace-down; }


    Mod+CTRL+Left                            { move-column-to-monitor-left; }
    Mod+CTRL+H                               { move-column-to-monitor-left; }
    Mod+CTRL+Right                           { move-column-to-monitor-right; }
    Mod+CTRL+L                               { move-column-to-monitor-right; }
    Mod+CTRL+Up                              { move-column-to-workspace-up; }
    Mod+CTRL+K                               { move-column-to-workspace-up; }
    Mod+CTRL+Down                            { move-column-to-workspace-down; }
    Mod+CTRL+J                               { move-column-to-workspace-down; }

    
    Mod+Home                            { focus-column-first; }
    Mod+End                             { focus-column-last; }
    Mod+CTRL+Home                       { move-column-to-first; }
    Mod+CTRL+End                        { move-column-to-last; }

    
    // ─── Workspace Switching ───
    Mod+WheelScrollDown                 cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp                   cooldown-ms=150 { focus-workspace-up; }
    Mod+CTRL+WheelScrollDown            cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+CTRL+WheelScrollUp              cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight                { focus-column-right; }
    Mod+WheelScrollLeft                 { focus-column-left; }
    Mod+CTRL+WheelScrollRight           { move-column-right; }
    Mod+CTRL+WheelScrollLeft            { move-column-left; }

    Mod+Shift+WheelScrollDown           { focus-column-right; }
    Mod+Shift+WheelScrollUp             { focus-column-left; }
    Mod+CTRL+Shift+WheelScrollDown      { move-column-right; }
    Mod+CTRL+Shift+WheelScrollUp        { move-column-left; }

    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }
    Mod+5                               { focus-workspace 5; }
    Mod+6                               { focus-workspace 6; }
    Mod+7                               { focus-workspace 7; }
    Mod+8                               { focus-workspace 8; }
    Mod+9                               { focus-workspace 9; }

    Mod+shift+1                          { move-column-to-workspace 1; }
    Mod+shift+2                          { move-column-to-workspace 2; }
    Mod+shift+3                          { move-column-to-workspace 3; }
    Mod+shift+4                          { move-column-to-workspace 4; }
    Mod+shift+5                          { move-column-to-workspace 5; }
    Mod+shift+6                          { move-column-to-workspace 6; }
    Mod+shift+7                          { move-column-to-workspace 7; }
    Mod+shift+8                          { move-column-to-workspace 8; }
    Mod+shift+9                          { move-column-to-workspace 9; }

//    Mod+TAB                             { focus-workspace-previous; }

    // ─── Layout Controls ───
    Mod+CTRL+F                          { expand-column-to-available-width; }
    Mod+C                               { center-column; }
    Mod+CTRL+C                          { center-visible-columns; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }

    // ─── Modes ───
    Mod+T                               { toggle-window-floating; }
    Mod+Shift+F                               { fullscreen-window; }
    Mod+F                                       { maximize-column; }
    Mod+W                               { toggle-column-tabbed-display; }

    Mod+R { switch-preset-column-width; }
    // Cycling through the presets in reverse order is also possible.
    // Mod+R { switch-preset-column-width-back; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    // ─── Screenshots ───
    CTRL+Shift+1                        { screenshot; }
    CTRL+Shift+2                        { screenshot-screen; }
    CTRL+Shift+3                        { screenshot-window; }

    // ─── Emergency Escape Key ───
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    Mod+ESCAPE                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Exit / Power ───
    CTRL+ALT+Delete                     { quit; } // Also quits Niri
    Mod+Shift+P                         { power-off-monitors; } // Turn off screens (useful for OLED or privacy)
    Mod+Tab                               repeat=false { toggle-overview; }
}
