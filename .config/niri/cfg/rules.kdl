// Corner radius and boarder geometry
window-rule {
        geometry-corner-radius 20
        clip-to-geometry true
    }



// Make inactive windows semitransparent and enable blur
window-rule {
    match is-active=false
    background-effect {
	    blur true
      xray false
	}

    opacity 0.80
}

// Enable noctalia in overview for static overview
layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }


// Noctalia: blur everywhere without xray for a better look */
layer-rule {
  match namespace="^noctalia-(background|launcher-overlay|dock)-.*$"
  background-effect {
    xray false
  }
}

    // Enable blur behind the kitty terminal.
window-rule {
    match app-id="^kitty$"
 
    background-effect {
        blur true
        xray false
    }
}
