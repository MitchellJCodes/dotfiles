// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup
    
    spawn-at-startup "noctalia"
    spawn-at-startup "swayidle" "-w" "before-sleep" "noctalia msg screen-lock"
    spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "icon-theme" "Papirus-Dark"
    spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "font-name" "Adwaita Sans 12"
    spawn-at-startup "pywalfox" "install"
